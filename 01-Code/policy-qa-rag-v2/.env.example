# Copy this file to .env (same folder) and fill in your own values. Never commit .env.
#   cp .env.example .env
# The v1 code (src/config.py) loads .env from this project root only.

# Required only for answer generation (Groq LLM). Retrieval, indexing and offline tests do not need it.
GROQ_API_KEY=your-groq-api-key-here

# Optional overrides (v1 defaults shown). Keep them identical for v1 vs v2 comparisons.
# LLM_MODEL=openai/gpt-oss-120b
# LLM_TEMPERATURE=0
# CHUNK_SIZE=800
# CHUNK_OVERLAP=150
# TOP_K=4
# MIN_SIMILARITY=0.25
# CHROMA_DIR=.chroma
# CHROMA_COLLECTION=policy_chunks
